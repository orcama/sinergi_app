# Gemma 4 E2B-derived legal checkpoint served by the local Metal vLLM process.
# MODEL_ID is only a fallback: startup discovers the model from /v1/models.
MODEL_ID=Legal-verse/InaVerdict-gemma-v2
VLLM_BASE_URL=http://127.0.0.1:8000

# Public provider: hosted InaVerdict Gemma 4 E2B demo on Hugging Face Spaces (Gradio API).
GRADIO_SPACE=galihww/inaverdict-gemma-v2-demo
# GRADIO_MODEL_ID=Legal-verse/InaVerdict-gemma-v2
# GRADIO_CONTEXT_WINDOW=65536
# GRADIO_MAX_NEW_TOKENS=512 (clamp 64-512; batas atas slider space)
# GRADIO_TEMPERATURE=0.2 (clamp 0-1.5)
# GRADIO_SYSTEM_PROMPT="Anda adalah asisten riset hukum Indonesia..." (default mengikuti space)
# GRADIO_HF_TOKEN=hf_xxx (naikkan kuota ZeroGPU HF Spaces; kosongkan untuk anonim)
# GRADIO_MAX_CHARS=12000 (panjang prompt maksimum; bagian akhir dokumen dipertahankan)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_TIMEOUT_SECONDS=300
# CHAT_SYSTEM_PROMPT=Override the legal-assistant prompt here. The backend also
# appends a mandatory instruction for Indonesian-language reasoning.
# Lets manual FastAPI startup print the URL generated by the launchd tunnel.
PUBLIC_TUNNEL_LOG="~/Library/Application Support/SinergiServer/logs/tunnel-error.log"

# On-demand mode keeps only the lightweight FastAPI gateway running. The first
# local-model request starts vLLM; vLLM stops after this many idle seconds.
VLLM_ON_DEMAND=false
VLLM_EXECUTABLE=~/.venv-vllm-metal/bin/vllm
VLLM_SERVE_MODEL=Legal-verse/InaVerdict-gemma-v2
VLLM_IDLE_TIMEOUT_SECONDS=300
VLLM_STARTUP_TIMEOUT_SECONDS=600
# The checkpoint supports 128K natively, but 64K is the safe 16 GB M4 profile
# after the model and Metal runtime reserve unified memory for the KV cache.
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_NUM_BATCHED_TOKENS=512
# vLLM Metal's paged path uses this knob for the KV-cache budget; the generic
# --gpu-memory-utilization flag is ignored by current Metal paged attention.
VLLM_METAL_USE_PAGED_ATTENTION=1
VLLM_METAL_MEMORY_FRACTION=0.90
VLLM_MLX_DEVICE=gpu
VLLM_ENABLE_THINKING=true
VLLM_REASONING_PARSER=gemma4
# VLLM_EXTRA_ARGS_JSON=["--some-flag","value"]

# Firebase Admin SDK
# Local development: point this at a file that is never committed.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Comma-separated list of Firebase UIDs that are granted the admin role (and auto-verified).
ADMIN_UIDS=
# Production option 1 (Secret Manager): store the complete JSON object in this
# variable. Do not paste it into a checked-in .env file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Production option 2 (Google Cloud): omit both variables and use the runtime
# service account via Application Default Credentials (ADC).
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIRESTORE_DATABASE_ID=(default)

# WandB-hosted multimodal model (see backend/models.md for usage and pricing).
# If WANDB_API_KEY is left empty, the gateway falls back to the key embedded in
# backend/models.md. That file is git-ignored, so it only exists on this machine.
WANDB_BASE_URL=https://api.inference.wandb.ai
WANDB_MODEL_ID=MiniMaxAI/MiniMax-M3
WANDB_API_KEY=
# Which provider to use when the frontend does not pick one: vllm or wandb.
DEFAULT_PROVIDER=vllm

# Embeddings for persisted Firestore vector search (384 dimensions).
EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Optional: fully define the providers served by /api/models as JSON. Each entry:
# {
#   "id": "unique provider id",
#   "name": "Display name shown in the frontend switch",
#   "model": "Model identifier sent to the inference endpoint",
#   "base_url": "http://host:port (vllm) or https://api.inference.wandb.ai (wandb)",
#   "kind": "vllm" or "wandb" (controls auth + text vs multimodal handling),
#   "supports_images": true|false,
#   "api_key_env": "WANDB_API_KEY" (only needed for kind=wandb)
# }
# When unset, the defaults above (vllm + wandb) are used.
# MODEL_PROVIDERS=[{"id":"vllm","name":"vLLM (Local)","model":"Legal-verse/InaVerdict-gemma-v2","base_url":"http://127.0.0.1:8000","kind":"vllm","supports_images":false},{"id":"wandb","name":"WandB (MiniMax M3)","model":"MiniMaxAI/MiniMax-M3","base_url":"https://api.inference.wandb.ai","kind":"wandb","supports_images":true,"api_key_env":"WANDB_API_KEY"}]
