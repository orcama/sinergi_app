# The MLX 4-bit conversion is derived from deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B.
MODEL_ID=mlx-community/DeepSeek-R1-Distill-Qwen-1.5B-4bit
VLLM_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_TIMEOUT_SECONDS=300
# CHAT_SYSTEM_PROMPT=Override the default legal-assistant prompt here.

# WandB-hosted multimodal model (see backend/models.md for usage and pricing).
# If WANDB_API_KEY is left empty, the gateway falls back to the key embedded in
# backend/models.md. That file is git-ignored, so it only exists on this machine.
WANDB_BASE_URL=https://api.inference.wandb.ai
WANDB_MODEL_ID=MiniMaxAI/MiniMax-M3
WANDB_API_KEY=
# Which provider to use when the frontend does not pick one: vllm or wandb.
DEFAULT_PROVIDER=vllm

# Optional: fully define the providers served by /api/models as JSON. Each entry:
# {
#   "id": "unique provider id",
#   "name": "Display name shown in the frontend switch",
#   "model": "Model identifier sent to the inference endpoint",
#   "base_url": "http://host:port (vllm) or https://api.inference.wandb.ai (wandb)",
#   "kind": "vllm" or "wandb" (controls auth + text vs multimodal handling),
#   "supports_images": true|false,
#   "api_key_env": "WANDB_API_KEY" (only needed for kind=wandb)
# }
# When unset, the defaults above (vllm + wandb) are used.
# MODEL_PROVIDERS=[{"id":"vllm","name":"vLLM (Local)","model":"mlx-community/DeepSeek-R1-Distill-Qwen-1.5B-4bit","base_url":"http://127.0.0.1:8000","kind":"vllm","supports_images":false},{"id":"wandb","name":"WandB (MiniMax M3)","model":"MiniMaxAI/MiniMax-M3","base_url":"https://api.inference.wandb.ai","kind":"wandb","supports_images":true,"api_key_env":"WANDB_API_KEY"}]
